{{- $agentConfig := true -}}
{{- if hasKey . "agent_config" -}}{{- $agentConfig = .agent_config -}}{{- end -}}
[user]
	name = {{ .name }}
	email = {{ .email }}
	signingkey = {{ .signingkey }}
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true
[credential "https://github.com"]
	helper =
	helper = !{{ .brewprefix }}/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{ .brewprefix }}/bin/gh auth git-credential
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
{{ if $agentConfig }}
# Agent Git defaults and the mergiraf driver, shared with runner02:
# TomaszJanusz/agent-config/git/agent.gitconfig. Git skips a missing include.
[include]
	path = {{ .chezmoi.homeDir }}/Developer/agent-config/git/agent.gitconfig
{{ end -}}
