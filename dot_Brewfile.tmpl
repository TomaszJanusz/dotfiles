# Shell & dotfiles
brew "fish"
brew "chezmoi"
brew "gum"

# Git
brew "git"
brew "git-lfs"
brew "gh"

# Search & navigation
brew "fzf"
brew "ripgrep"
brew "fd"
brew "zoxide"
