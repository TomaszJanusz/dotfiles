{{- $agentConfig := true -}}
{{- if hasKey . "agent_config" -}}{{- $agentConfig = .agent_config -}}{{- end -}}
{{ if and (eq .chezmoi.os "darwin") $agentConfig -}}
#!/bin/bash
# Skills and global agent instructions come from TomaszJanusz/agent-config.
# This only clones it once; kitbag (brew "TomaszJanusz/tap/kitbag", its own
# LaunchAgent dev.kitbag.agent) links it into the agents and keeps it current
# with repo.path = ~/Developer/agent-config. Runs before run_after_06, which
# links ~/.agents/skills into the agents kitbag does not manage.
set -euo pipefail

REPO="$HOME/Developer/agent-config"
# HTTPS through gh's credential helper: kitbag's background pull must not wait
# for a 1Password SSH approval.
URL="https://github.com/TomaszJanusz/agent-config.git"

if [ ! -d "$REPO/.git" ]; then
  if ! {{ .brewprefix }}/bin/gh auth status --hostname github.com >/dev/null 2>&1; then
    echo "agent-config: gh is not logged in; skipping. Run 'gh auth login', then 'chezmoi apply'."
    exit 0
  fi
  mkdir -p "$(dirname "$REPO")"
  git clone --quiet "$URL" "$REPO"
  echo "agent-config: cloned into $REPO"
fi

if [ ! -x {{ .brewprefix }}/bin/kitbag ] && ! command -v kitbag >/dev/null 2>&1; then
  echo "agent-config: kitbag is not installed, nothing links $REPO yet; see README (Agent skills)."
fi
{{ end -}}
