{{- $agentConfig := true -}}
{{- if hasKey . "agent_config" -}}{{- $agentConfig = .agent_config -}}{{- end -}}
{{ if and (eq .chezmoi.os "darwin") $agentConfig -}}
#!/bin/bash
# Reloads the agent-config sync LaunchAgent whenever its plist changes.
# plist hash: {{ include "private_Library/LaunchAgents/com.tjanusz.agent-config-sync.plist.tmpl" | sha256sum }}
set -euo pipefail

AGENT="$HOME/Library/LaunchAgents/com.tjanusz.agent-config-sync.plist"
LABEL="gui/$UID/com.tjanusz.agent-config-sync"

mkdir -p "$HOME/.local/state"
launchctl bootout "$LABEL" 2>/dev/null || true
launchctl bootstrap "gui/$UID" "$AGENT"

echo "agent-config sync LaunchAgent loaded — runs hourly."
{{ end -}}
