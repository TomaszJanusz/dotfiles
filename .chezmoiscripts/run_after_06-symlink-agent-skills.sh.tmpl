{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

SKILLS_DIR="$HOME/.agents/skills"

if [ ! -d "$SKILLS_DIR" ]; then
  echo "No $SKILLS_DIR — skipping per-agent symlinks."
  exit 0
fi

# Not claude or codex: kitbag owns ~/.claude/skills/<name> and
# ~/.agents/skills/<name> (Codex reads the latter). Linking claude here would
# replace kitbag's links with chains through ~/.agents/skills on every apply.
AGENTS=(cursor opencode zed gemini-cli antigravity)

# Earlier versions also linked ~/.codex/skills; kitbag never writes there, so
# drop those links (only ones pointing into $SKILLS_DIR) to avoid duplicates.
for link in "$HOME/.codex/skills"/*; do
  [ -L "$link" ] || continue
  case "$(readlink "$link")" in
    "$SKILLS_DIR"/*) rm -f "$link" ;;
  esac
done

for agent in "${AGENTS[@]}"; do
  target="$HOME/.$agent/skills"
  mkdir -p "$target"

  # Usuń dangling/stale symlinki (skill mógł zostać odznaczony i zniknąć z ~/.agents/skills/)
  for link in "$target"/*; do
    [ -L "$link" ] || continue
    [ -e "$link" ] || rm -f "$link"
  done

  for skill in "$SKILLS_DIR"/*/; do
    [ -d "$skill" ] || continue
    name=$(basename "$skill")
    ln -sfn "$skill" "$target/$name"
  done
done

echo "Agent skill symlinks refreshed."
{{ end -}}
