{{- $agentConfig := true -}}
{{- if hasKey . "agent_config" -}}{{- $agentConfig = .agent_config -}}{{- end -}}
{{ if and (eq .chezmoi.os "darwin") $agentConfig -}}
#!/bin/bash
# Skills and global agent instructions come from TomaszJanusz/agent-config.
# This clones it once and links it into the agents; the LaunchAgent
# com.tjanusz.agent-config-sync keeps it current afterwards. Runs before
# run_after_06, which then links ~/.agents/skills into the remaining agents.
set -euo pipefail

REPO="$HOME/Developer/agent-config"
# HTTPS through gh's credential helper: the hourly background pull must not
# wait for a 1Password SSH approval.
URL="https://github.com/TomaszJanusz/agent-config.git"

if [ ! -d "$REPO/.git" ]; then
  if ! {{ .brewprefix }}/bin/gh auth status --hostname github.com >/dev/null 2>&1; then
    echo "agent-config: gh is not logged in; skipping. Run 'gh auth login', then 'chezmoi apply'."
    exit 0
  fi
  mkdir -p "$(dirname "$REPO")"
  git clone --quiet "$URL" "$REPO"
  echo "agent-config: cloned into $REPO"
fi

# --adopt moves aside skill directories an earlier setup copied in, so the
# repository's links can replace them.
"$REPO/bin/agent-config-sync" --adopt || echo "agent-config: sync finished with warnings (see above)."
{{ end -}}
