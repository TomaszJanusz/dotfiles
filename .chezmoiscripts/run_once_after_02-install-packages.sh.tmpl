#!/bin/bash
set -euo pipefail

# Ensure brew is in PATH
eval "$({{ .brewprefix }}/bin/brew shellenv)"

BREWFILE="$HOME/.Brewfile"

if [ ! -f "$BREWFILE" ]; then
    echo "Error: $BREWFILE not found." >&2
    echo "chezmoi should have created it from dot_Brewfile.tmpl during apply." >&2
    echo "Run: chezmoi managed | grep -i brewfile" >&2
    exit 1
fi

FORMULAE=$(grep -cE '^brew '   "$BREWFILE" || true)
CASKS=$(grep -cE   '^cask '    "$BREWFILE" || true)
TAPS=$(grep -cE    '^tap '     "$BREWFILE" || true)
MAS=$(grep -cE     '^mas '     "$BREWFILE" || true)
TOTAL=$((FORMULAE + CASKS + TAPS + MAS))

cat <<EOF
Installing $TOTAL packages from $BREWFILE:
  - $FORMULAE formulae (brew)
  - $CASKS casks
  - $TAPS taps
  - $MAS Mac App Store apps

This typically takes 10-30 minutes on a fresh setup depending on network speed.
brew will print progress per package below.

EOF

HOMEBREW_VERBOSE_USING_DOTS=1 \
HOMEBREW_DOWNLOAD_CONCURRENCY=1 \
    brew bundle install --file="$BREWFILE" --verbose

echo
echo "Cleaning up..."
brew cleanup

echo "Packages installed."
