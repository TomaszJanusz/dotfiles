{{- $name := promptStringOnce . "name" "Git user name" "Tomasz Janusz" -}}
{{- $email := promptStringOnce . "email" "Git email" "tomasz.janusz@gmail.com" -}}
{{- $signingkey := promptStringOnce . "signingkey" "SSH signing key (public)" "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPOWCi6L+bMTfPFhYU2045cpFeYA3spmaaqMPth6o1B/" -}}
{{- $useAntigravity := promptBoolOnce . "use_antigravity" "Add Antigravity to PATH" false -}}
{{- $debloatMacos := promptBoolOnce . "debloat_macos" "Debloat macOS (clean Dock, mute bundled apps)" true -}}
{{- $cleanupOldFiles := promptBoolOnce . "cleanup_old_files" "Auto-trash files >30 days in Downloads/Screenshots (daily at 03:00)" true -}}
{{- $projektySymlink := promptBoolOnce . "projekty_symlink" "Create hidden ~/Projekty symlink pointing to ~/Developer" true -}}
{{- $agentConfig := promptBoolOnce . "agent_config" "Clone TomaszJanusz/agent-config and install kitbag to sync agent skills and global instructions" true -}}
{{- $agentTools := promptBoolOnce . "agent_tools" "Install coding-agent tools (agent-browser, ast-grep, mergiraf, linters) and agent git defaults" true -}}

{{- /* Compute brew prefix based on architecture */ -}}
{{- $brewprefix := "/opt/homebrew" -}}
{{- if eq .chezmoi.arch "amd64" -}}
{{-   $brewprefix = "/usr/local" -}}
{{- end -}}

{{- /* Package selection. Each gum list starts from the choice saved in
       chezmoi.toml by the previous init; the "defaults" below only apply on a
       fresh machine. Re-running init is therefore safe for small changes. */ -}}
{{- $saved := list -}}
{{- $hasSaved := hasKey . "packages" -}}
{{- if $hasSaved -}}
{{-   $saved = .packages | splitList "\n" | compact -}}
{{- end -}}

{{- $catalog := list
  (dict "group" "dev-tools" "header" "Dev tools (deselect what you don't need):"
        "defaults" (list "webstorm" "zed" "visual-studio-code" "karabiner-elements" "dash" "orbstack")
        "items" (list "webstorm" "zed" "visual-studio-code" "visual-studio-code@insiders" "karabiner-elements" "dash" "go" "alfred" "orbstack"))
  (dict "group" "productivity" "header" "Productivity apps:"
        "defaults" (list "obsidian" "notion" "mailmate" "claude" "chatgpt" "popclip" "rectangle-pro")
        "items" (list "obsidian" "notion" "mailmate" "claude" "chatgpt" "popclip" "rectangle-pro"))
  (dict "group" "media" "header" "Media tools:"
        "defaults" (list "vlc" "handbrake" "transmission")
        "items" (list "vlc" "handbrake" "transmission" "downie" "camtasia" "snagit" "eqmac"))
  (dict "group" "security" "header" "Security & Network:"
        "defaults" (list "gpg-suite" "signal")
        "items" (list "gpg-suite" "signal" "tunnelbear" "windscribe"))
  (dict "group" "utils" "header" "Utilities:"
        "defaults" (list "tmux" "ncdu" "thefuck" "pearcleaner" "cyberduck")
        "items" (list "tmux" "cmux" "ncdu" "thefuck" "pearcleaner" "cyberduck" "balenaetcher" "yt-dlp" "glab" "tokei" "midnight-commander" "entr" "ansible" "cloc" "fresh" "kaset" "atoll"))
  (dict "group" "macos-extras" "header" "macOS extras:"
        "defaults" (list "qlmarkdown" "mas-amphetamine" "mas-infuse")
        "items" (list "qlmarkdown" "mas-amphetamine" "mas-infuse" "mas-turn-off-lights"))
  (dict "group" "browsers" "header" "Browsers:"
        "defaults" (list "google-chrome" "firefox")
        "items" (list "google-chrome" "google-chrome@dev" "firefox" "firefox@developer-edition" "brave-browser@beta" "helium-browser" "zen"))
  (dict "group" "AI" "header" "AI tools:"
        "defaults" (list "opencode" "gemini-cli" "codex" "claude-code" "notion-cli")
        "items" (list "opencode" "gemini-cli" "codex" "codex-app" "claude-code" "notion-cli" "pi-coding-agent" "t3-code" "cursor-cli"))
  (dict "group" "design" "header" "Design tools:"
        "defaults" (list)
        "items" (list "affinity" "inkscape"))
-}}
{{- $karabiner := dict "header" "Karabiner rules (per active mapping):"
      "defaults" (list) "items" (list "karabiner-krux" "karabiner-k380" "karabiner-coma") -}}

{{- /* === STEP 1: Select package groups === */ -}}
{{- $groupNames := list -}}
{{- $groupDefaults := list -}}
{{- range $catalog -}}
{{-   $groupNames = append $groupNames .group -}}
{{-   $preselect := gt (len .defaults) 0 -}}
{{-   if $hasSaved -}}
{{-     $preselect = false -}}
{{-     range .items -}}
{{-       if has . $saved -}}{{- $preselect = true -}}{{- end -}}
{{-     end -}}
{{-   end -}}
{{-   if $preselect -}}{{- $groupDefaults = append $groupDefaults .group -}}{{- end -}}
{{- end -}}
{{- $groups := outputList "gum" (concat (list "choose" "--no-limit" "--header" "Select package groups to install:" "--selected" (join "," $groupDefaults)) $groupNames) | splitList "\n" -}}

{{- /* === STEP 2: Per-group package selection === */ -}}
{{- $chosen := list -}}
{{- range $catalog -}}
{{-   if has .group $groups -}}
{{-     $selected := .defaults -}}
{{-     if $hasSaved -}}
{{-       $selected = list -}}
{{-       range .items -}}
{{-         if has . $saved -}}{{- $selected = append $selected . -}}{{- end -}}
{{-       end -}}
{{-     end -}}
{{-     $chosen = append $chosen (outputList "gum" (concat (list "choose" "--no-limit" "--header" .header "--selected" (join "," $selected)) .items)) -}}
{{-   end -}}
{{- end -}}

{{- if contains "karabiner-elements" (join "\n" $chosen) -}}
{{-   $selected := $karabiner.defaults -}}
{{-   if $hasSaved -}}
{{-     $selected = list -}}
{{-     range $karabiner.items -}}
{{-       if has . $saved -}}{{- $selected = append $selected . -}}{{- end -}}
{{-     end -}}
{{-   end -}}
{{-   $chosen = append $chosen (outputList "gum" (concat (list "choose" "--no-limit" "--header" $karabiner.header "--selected" (join "," $selected)) $karabiner.items)) -}}
{{- end -}}

{{- $allPkgs := join "\n" $chosen -}}

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    signingkey = {{ $signingkey | quote }}
    brewprefix = {{ $brewprefix | quote }}
    use_antigravity = {{ $useAntigravity }}
    debloat_macos = {{ $debloatMacos }}
    cleanup_old_files = {{ $cleanupOldFiles }}
    projekty_symlink = {{ $projektySymlink }}
    agent_config = {{ $agentConfig }}
    agent_tools = {{ $agentTools }}
    packages = {{ $allPkgs | quote }}
