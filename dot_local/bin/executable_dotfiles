#!/bin/bash
set -euo pipefail

# Global verbose flag: dotfiles -v <cmd>  /  dotfiles --verbose <cmd>
VERBOSE=""
if [[ "${1:-}" == "-v" || "${1:-}" == "--verbose" ]]; then
    VERBOSE="-v"
    shift
fi

cmd="${1:-help}"
shift || true

source_dir() { chezmoi source-path; }

brewfile_hash() {
    [ -f "$HOME/.Brewfile" ] && shasum -a 256 "$HOME/.Brewfile" | awk '{print $1}' || echo ""
}

maybe_brew_bundle() {
    # Compares pre/post Brewfile sha; if changed, runs brew bundle install.
    # This is a belt-and-suspenders fallback for the run_onchange_ script —
    # if chezmoi didn't pick up the change for any reason, we still install.
    local before="$1"
    local after
    after="$(brewfile_hash)"
    if [ -n "$after" ] && [ "$before" != "$after" ]; then
        echo "~/.Brewfile changed — running brew bundle install"
        brew bundle install --file="$HOME/.Brewfile"
    fi
}

case "$cmd" in
  update|up)
    bf_before="$(brewfile_hash)"
    chezmoi update $VERBOSE
    maybe_brew_bundle "$bf_before"
    ;;

  apply|a)
    bf_before="$(brewfile_hash)"
    chezmoi apply $VERBOSE
    maybe_brew_bundle "$bf_before"
    ;;

  diff|d)
    chezmoi diff
    ;;

  status|st)
    chezmoi status
    ;;

  save)
    # Pull current state of managed files into source dir, show what changed
    chezmoi re-add
    git -C "$(source_dir)" status -sb
    ;;

  commit|c)
    if [ $# -eq 0 ]; then
      echo "usage: dotfiles commit <message>" >&2
      exit 2
    fi
    chezmoi re-add
    src="$(source_dir)"
    git -C "$src" add -A
    git -C "$src" commit -m "$*"
    ;;

  push)
    git -C "$(source_dir)" push
    ;;

  sync)
    # Full bidirectional cycle: pull remote, apply, capture local
    bf_before="$(brewfile_hash)"
    chezmoi update $VERBOSE
    maybe_brew_bundle "$bf_before"
    chezmoi re-add
    git -C "$(source_dir)" status -sb
    ;;

  reinit)
    # Re-run gum prompts to pick up new options added to .chezmoi.toml.tmpl
    # (e.g. when a new package appeared in a gum choose since last init).
    echo "Pulling latest source..."
    git -C "$(source_dir)" pull --ff-only
    cat <<MSG

Now re-running chezmoi init — you'll see every gum screen again, with
your current selections pre-checked. Hit Enter through ones you don't
want to change; press Space on new options you want to add.

After init finishes, run:
  dotfiles apply

MSG
    chezmoi init
    ;;

  edit|e)
    chezmoi edit "$@"
    ;;

  log|l)
    git -C "$(source_dir)" log --oneline -20
    ;;

  path)
    source_dir
    ;;

  reset-once)
    # Force run_once_* scripts to re-run on next apply
    chezmoi state delete-bucket --bucket=scriptState
    echo "scriptState cleared — run_once_* scripts will re-execute on next apply"
    ;;

  help|--help|-h|"")
    cat <<EOF
dotfiles — zarządzanie dotfiles przez chezmoi + git

Sytuacja: są DWA źródła stanu — repo (source) w \$(dotfiles path) i
realne configi w \$HOME. Te komendy synchronizują je w jedną lub drugą stronę.

Użycie:
  dotfiles [-v|--verbose] <komenda> [argumenty]

Flaga -v / --verbose przed komendą włącza verbose output dla
update/apply/sync (drukuje rendered content uruchamianych
skryptów). Bez niej output jest zwięzły.

DOM → REPO (zapis lokalnych zmian do repo, bez wysyłki do GitHub)
  save              Wciągnij obecny stan configów z \$HOME do repo. Pokaż git status.
                    NIE commituje, NIE pusha. Bezpieczne "preview before commit".
  commit, c <msg>   To samo co save + git commit z podanym message. Nadal NIE pusha.
  push              Wyślij już zacommitowane zmiany na GitHub.

REPO → DOM (przyjęcie zmian z repo do realnych configów)
  update, up        Pobierz commity z GitHub i odśwież pliki w \$HOME.
                    Jeśli ~/.Brewfile się zmieni, automatycznie zainstaluje
                    nowe pakiety. Najczęstsza komenda po włączeniu drugiej maszyny.
  apply, a          Odśwież pliki w \$HOME ze stanu repo (BEZ pobierania z GitHub).
                    Też wykrywa zmianę Brewfile i odpala brew bundle install.
                    Użyteczne po lokalnej edycji szablonu w repo.
  reinit            Pull + chezmoi init (przelatuje gum ekrany). Użyj gdy
                    do .chezmoi.toml.tmpl doszły nowe opcje (np. nowy pakiet
                    w gum choose) i chcesz je zaznaczyć.

INSPEKCJA (nic nie zmienia)
  diff, d           Pokaż co zmieni "apply" w plikach w \$HOME przed wykonaniem.
  status, st        Lista plików w \$HOME różniących się od stanu repo.
  log, l            Ostatnie 20 commitów w repo.
  path              Wypisz ścieżkę do source dir (\$(dotfiles path)).

OPERACJE ŁĄCZONE
  sync              Pełen cykl: update (z GitHub) → save (lokalne zmiany do repo) → status.
                    Pokazuje co przyleciało z remote i co masz do zacommitowania.
  edit, e <file>    Otwórz plik w repo do edycji (a nie kopię w \$HOME).
                    Po zamknięciu edytora chezmoi nałoży zmiany.
  reset-once        Wyczyść licznik "raz w życiu" dla skryptów run_once_*.
                    Następny apply odpali je ponownie (np. ponowna instalacja extensions).
  help              Ten tekst.

Repo: $(source_dir 2>/dev/null || echo "<chezmoi nieskonfigurowany>")
EOF
    ;;

  *)
    echo "unknown command: $cmd" >&2
    echo "try: dotfiles help" >&2
    exit 2
    ;;
esac
